{
  "name": "@useorgx/claude-code-plugin",
  "version": "0.1.12",
  "description": "OrgX read-only MCP connector and static, user-invoked workflows for Claude Code",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/useorgx/orgx-claude-code-plugin.git"
  },
  "files": [
    ".claude-plugin/",
    ".mcp.json",
    "commands/",
    "skills/",
    "plugin.manifest.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "manifest:refresh": "node tooling/refresh-plugin-manifest.mjs --write",
    "manifest:check": "node tooling/refresh-plugin-manifest.mjs --check",
    "verify": "node tooling/verify-plugin.mjs",
    "check": "npm run typecheck && npm run test && npm run verify",
    "prepublishOnly": "npm run check",
    "pack": "mkdir -p artifacts && npm pack --pack-destination artifacts",
    "release:dry-run": "node tooling/release-dry-run.mjs",
    "dev:claude": "claude --plugin-dir ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
